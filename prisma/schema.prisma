// CRM Elettra S.r.l. — Schema dati
//
// Note di progetto:
// - PostgreSQL in sviluppo e produzione: stessi tipi e stesse migrazioni.
// - I campi a scelta chiusa restano String, validati da src/lib/enums.ts + zod.
// - Lo storico SQLite è archiviato in legacy-sqlite; non applicarlo a Postgres.
// - Doppia natura Cliente/Fornitore: UNA anagrafica per azienda, con fino a due
//   codici (codiceCliente "C####" e codiceFornitore "F####").

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Utenti del CRM con ruolo (gerarchia di accesso).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nome         String
  cognome      String
  ruolo        String // vedi RUOLI in src/lib/enums.ts
  attivo       Boolean  @default(true)
  /// Chiavi dei tour di guida già visti, separate da virgola (`*` = tutti). Vedi src/lib/guida.ts.
  guidaVista   String   @default("")
  sessionVersion Int    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  commesse      Commessa[]     @relation("CommessaPM")
  segnalazioni  Segnalazione[] @relation("SegnalazioneAutore")
  aiConversations AiConversation[]
  aiOperations AiOperation[]
  aiSchedules AiSchedule[]
  notifiche Notifica[]
  attivita Attivita[]
  modificheEconomiche ModificaEconomica[]
  opportunita Opportunita[]
  eventiCommerciali EventoCommerciale[]
  bozzeCommesse BozzaCommessa[]

  @@index([ruolo])
}

/// Anagrafica azienda: può essere cliente e/o fornitore (doppia natura).
model Anagrafica {
  id              String  @id @default(cuid())
  ragioneSociale  String
  // Codifica doppia — al massimo uno per ruolo, univoci quando presenti.
  codiceCliente   String? @unique
  codiceFornitore String? @unique
  isCliente       Boolean @default(false)
  isFornitore     Boolean @default(false)
  isProspect      Boolean @default(false)

  // Dati fiscali e di contatto
  partitaIva     String?
  codiceFiscale  String?
  codiceSDI      String? // Codice destinatario / Univoco fatturazione
  indirizzo      String?
  cap            String?
  localita       String?
  provincia      String?
  telefono       String?
  fax            String?
  email          String?
  web            String?

  modalitaPagamento String?
  prodottiTrattati  String? // categorie merceologiche trattate (per i fornitori)
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referenti       Referente[]
  destinazioni    Destinazione[]
  commesse        Commessa[]        @relation("CommessaCliente")
  ordiniFornitore OrdineFornitore[] @relation("OrdineFornitore")
  attivita Attivita[]
  tariffario TariffarioCliente?
  consuntivi Consuntivo[]
  opportunita Opportunita[]

  @@index([ragioneSociale])
}

/// Sede di consegna / cantiere di un'azienda (i codici "D####" dell'Excel
/// Elettra). Non sono anagrafiche a sé: 1058 delle 1118 destinazioni portano il
/// nome di un cliente già presente e solo 108 hanno la P.IVA. Il codice può
/// avere un suffisso (D0000, D0000-1) quando un'azienda ha più sedi.
model Destinazione {
  id           String @id @default(cuid())
  anagraficaId String

  codice      String  @unique // es. "D0042" o "D0042-1"
  descrizione String? // nome del sito quando differisce dalla ragione sociale
  indirizzo   String?
  cap         String?
  localita    String?
  provincia   String?
  telefono    String?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anagrafica Anagrafica @relation(fields: [anagraficaId], references: [id], onDelete: Cascade)

  @@index([anagraficaId])
  @@index([localita])
}

/// Referente normalizzato: titolo obbligatorio da lista (src/lib/enums.ts).
model Referente {
  id           String  @id @default(cuid())
  anagraficaId String
  titolo       String  @default("NESSUNO")
  nome         String
  cognome      String
  ruoloAzienda String? // es. "Responsabile acquisti"
  email        String?
  telefono     String?
  note         String?
  principale   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anagrafica Anagrafica @relation(fields: [anagraficaId], references: [id], onDelete: Cascade)
  commesse   Commessa[]
  opportunita Opportunita[]

  @@index([anagraficaId])
}

/// Commessa / Opportunità (pipeline commerciale).
model Commessa {
  id          String  @id @default(cuid())
  numero      String  @unique // formato AANNNN, es. "261041"
  anno        Int // es. 2026
  progressivo Int // 0..99999

  clienteId            String
  pmId                 String?
  referenteId          String?
  referenteCommerciale String? // sigla, es. "FG"

  stato      String  @default("LEAD") // vedi STATI_COMMESSA
  tipologia  String? // "P" (preventivo) | "C" (consuntivo)
  descrizione String?

  dataRichiesta         DateTime  @default(now())
  dataInvio             DateTime?
  importoOfferta        Decimal?
  importoOrdine         Decimal?
  dataOrdine            DateTime?
  metodoRicezioneOrdine String? // EMAIL | TELEFONO | CONTROFIRMA | NUMERO_ORDINE
  oda                   String? // numero d'ordine del cliente (colonna ODA dell'Excel)
  motivazionePersa      String?

  // --- Fase 7: la commessa come progetto di cantiere ---
  // Non esiste un'entità "Progetto" separata: un progetto È una commessa
  // acquisita in esecuzione (vedi statiProgetto in src/lib/progetti.ts). Queste
  // date sono la pianificazione di cantiere, distinte da quelle commerciali.
  dataInizioLavori  DateTime?
  scadenzaLavori    DateTime? // consegna concordata col cliente
  dataFineLavori    DateTime? // chiusura effettiva del cantiere
  noteCantiere      String?
  indirizzoCantiere String?
  sospeso          Boolean @default(false)
  motivoSospensione String?
  versioneOperativa Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente         Anagrafica        @relation("CommessaCliente", fields: [clienteId], references: [id])
  pm              User?             @relation("CommessaPM", fields: [pmId], references: [id])
  referente       Referente?        @relation(fields: [referenteId], references: [id])
  ordiniFornitore OrdineFornitore[]
  documenti       Documento[]
  milestone       Milestone[]
  assegnazioni    AssegnazioneOperaio[]
  attivita        Attivita[]
  consuntivo      Consuntivo?
  opportunitaId   String? @unique
  opportunita     Opportunita? @relation(fields: [opportunitaId], references: [id], onDelete: Restrict)
  bozzaOrigine    BozzaCommessa?
  aggiornamenti  AggiornamentoCantiere[]
  problemi       ProblemaCantiere[]

  @@index([clienteId])
  @@index([stato])
  @@index([anno])
  @@index([scadenzaLavori])
  @@index([pmId, stato])
}

/// Registro operativo append-only: fotografia delle variazioni, non un secondo SAL.
model AggiornamentoCantiere {
  id String @id @default(cuid())
  richiestaId String @unique
  richiestaHash String
  commessaId String
  autoreId String
  autoreNome String
  tipo String @default("SAL")
  data DateTime @db.Date
  nota String?
  prima Json
  dopo Json
  createdAt DateTime @default(now())
  commessa Commessa @relation(fields: [commessaId], references: [id], onDelete: Restrict)
  documenti Documento[]
  @@index([commessaId, createdAt])
}

model ProblemaCantiere {
  id String @id @default(cuid())
  richiestaId String @unique
  richiestaHash String
  commessaId String
  titolo String
  descrizione String
  priorita String @default("MEDIA")
  stato String @default("APERTA")
  autoreId String
  autoreNome String
  assegnatarioId String?
  scadenza DateTime? @db.Date
  versione Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  commessa Commessa @relation(fields: [commessaId], references: [id], onDelete: Restrict)
  eventi EventoProblema[]
  documenti Documento[]
  attivita Attivita?
  @@index([commessaId, stato])
  @@index([assegnatarioId, stato, scadenza])
}

model EventoProblema {
  id String @id @default(cuid())
  richiestaId String @unique
  richiestaHash String
  problemaId String
  autoreId String
  autoreNome String
  testo String
  prima Json?
  dopo Json?
  createdAt DateTime @default(now())
  problema ProblemaCantiere @relation(fields: [problemaId], references: [id], onDelete: Restrict)
  @@index([problemaId, createdAt])
}

/// Preparazione privata: non è una commessa e non entra nei KPI o nelle risorse.
/// L'ID scelto dal client rende recuperabile anche il primo salvataggio ritentato.
model BozzaCommessa {
  id          String   @id
  autoreId    String?
  autore      User?    @relation(fields: [autoreId], references: [id], onDelete: SetNull)
  versione    Int      @default(1)
  passo       Int      @default(0)
  dati        Json
  commessaId  String?  @unique
  commessa    Commessa? @relation(fields: [commessaId], references: [id], onDelete: Restrict)
  documenti   Documento[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([autoreId, updatedAt])
}

/// Listino riusabile del cliente. Le righe JSON sono validate dal servizio
/// economico; ogni revisione è conservata integralmente nello storico.
model TariffarioCliente {
  id         String   @id @default(cuid())
  clienteId  String   @unique
  versione   Int      @default(1)
  manodopera Json
  materiali  Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cliente Anagrafica @relation(fields: [clienteId], references: [id], onDelete: Restrict)
}

/// Un rendiconto ore/materiali per lavoro, con valori e fonte tariffaria
/// fotografati sulle righe: cambiare il listino non rivaluta lo storico.
model Consuntivo {
  id              String   @id @default(cuid())
  commessaId      String   @unique
  clienteId       String
  versione        Int      @default(1)
  data            DateTime @db.Date
  note            String?
  righe           Json
  totaleOre       Decimal  @db.Decimal(16, 2)
  totaleMateriali Decimal  @db.Decimal(16, 2)
  totale          Decimal  @db.Decimal(16, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  commessa Commessa   @relation(fields: [commessaId], references: [id], onDelete: Restrict)
  cliente  Anagrafica @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@index([clienteId, data])
}

/// Registro append-only applicativo: nessuna action di modifica/eliminazione.
/// L'identità rimane leggibile anche dopo l'eliminazione dell'account.
model ModificaEconomica {
  id          String   @id @default(cuid())
  entita      String
  entitaId    String
  versione    Int
  autoreId    String?
  autoreNome  String
  autoreRuolo String
  prima       Json?
  dopo        Json
  createdAt   DateTime @default(now())

  autore User? @relation(fields: [autoreId], references: [id], onDelete: SetNull)

  @@unique([entita, entitaId, versione])
}

/// Milestone di rilascio di un progetto (Fase 7). L'avanzamento del progetto è
/// **derivato** da queste righe (peso proporzionale ai giorni previsti): non esiste
/// una percentuale scritta a mano, così non può divergere dallo stato reale.
model Milestone {
  id         String @id @default(cuid())
  commessaId String

  titolo String
  ordine Int // posizione nella sequenza, 0-based
  stato  String @default("DA_FARE") // vedi STATI_MILESTONE in enums.ts

  dataPianificata DateTime?
  durataGiorni    Float? // giorni lavorativi previsti; null = pianificazione incompleta
  dataEffettiva   DateTime? // valorizzata quando passa a COMPLETATA
  note            String?

  /// Milestone di esempio caricata per la presentazione, non pianificazione
  /// reale. È un campo e non una convenzione sul titolo così la UI può
  /// dichiararlo apertamente e lo script di pulizia può rimuoverle tutte.
  dimostrativa Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commessa Commessa @relation(fields: [commessaId], references: [id], onDelete: Cascade)

  @@index([commessaId, ordine])
  @@index([stato])
}

/// Anagrafica operai/squadre di cantiere (Fase 7). Separata da `User`: gli
/// operai non accedono al CRM, sono risorse assegnabili ai progetti. Quando
/// servirà il timesheet, le ore si agganceranno a AssegnazioneOperaio.
model Operaio {
  id        String  @id @default(cuid())
  nome      String
  cognome   String
  qualifica String? // es. "Elettricista", "Capo squadra"
  squadre   Squadra[] @relation("ComponentiSquadra")
  telefono  String?
  attivo    Boolean @default(true)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assegnazioni AssegnazioneOperaio[]

  @@index([cognome, nome])
}

/// Squadra centrale: ogni persona può appartenere a più squadre.
model Squadra {
  id        String @id @default(cuid())
  nome      String @unique
  note      String?
  attiva    Boolean @default(true)
  membri    Operaio[] @relation("ComponentiSquadra")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Una persona può lavorare su più cantieri contemporaneamente, una volta per cantiere.
model AssegnazioneOperaio {
  id         String @id @default(cuid())
  commessaId String
  operaioId  String

  ruoloCantiere String? // vedi RUOLI_CANTIERE in enums.ts
  dal           DateTime?
  al            DateTime?
  note          String?

  createdAt DateTime @default(now())

  commessa Commessa @relation(fields: [commessaId], references: [id], onDelete: Cascade)
  operaio  Operaio  @relation(fields: [operaioId], references: [id], onDelete: Cascade)

  @@unique([commessaId, operaioId])
  @@index([commessaId])
  @@index([operaioId])
}

/// Prodotto / materiale a catalogo. Anagrafica del materiale (anche da scheda
/// tecnica fornitore); lo storico prezzi resta derivato dalle righe d'ordine e
/// si aggancia via codice/descrizione.
model Prodotto {
  id          String  @id @default(cuid())
  codice      String? @unique
  descrizione String
  unitaMisura String?
  categoria   String?
  marca       String?
  datiTecnici String? // caratteristiche tecniche (testo, es. da scheda)
  note        String?
  prezzoListino Decimal? // prezzo di listino indicativo (dalla scheda), opzionale

  // Scheda tecnica (datasheet PDF) allegata — un file per prodotto.
  // Archiviata fuori da /public, servita da route handler autenticato.
  schedaNomeFile   String?
  schedaMime       String?
  schedaPercorso   String? // relativo a UPLOADS_DIR: "materiali/<id>/<file>"
  schedaDimensione Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  righeOrdine RigaOrdineFornitore[]

  @@index([descrizione])
  @@index([categoria])
}

/// Ordine a fornitore ("Elenco Analitico Ordini ai Fornitori").
/// Collegato alla commessa: è la chiave della regola bloccante P -> C.
model OrdineFornitore {
  id          String   @id @default(cuid())
  numero      String?
  data        DateTime @default(now())
  fornitoreId String
  commessaId  String?
  stato       String   @default("ORDINATO") // ORDINATO | ENTRATA | RICEVUTO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fornitore Anagrafica            @relation("OrdineFornitore", fields: [fornitoreId], references: [id])
  commessa  Commessa?             @relation(fields: [commessaId], references: [id])
  righe     RigaOrdineFornitore[]

  @@index([fornitoreId])
  @@index([commessaId])
}

/// Riga d'ordine: prodotto, quantità e prezzo. Alimenta lo storico prezzi.
model RigaOrdineFornitore {
  id            String   @id @default(cuid())
  ordineId      String
  prodottoId    String?
  codiceProdotto String?
  descrizione   String
  unitaMisura   String?
  quantita      Decimal  @default(0)
  prezzoUnitario Decimal @default(0)
  sconto        Decimal?
  imponibile    Decimal  @default(0)
  aliquotaIva   Decimal?

  // Entrata merce
  dataConsegnaPrevista DateTime?
  quantitaRicevuta     Decimal?
  ddtNumero            String?
  ddtData              DateTime?
  fatturaNumero        String?
  fatturaData          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordine   OrdineFornitore @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  prodotto Prodotto?       @relation(fields: [prodottoId], references: [id])

  @@index([ordineId])
  @@index([prodottoId])
}

/// Documenti allegati alla commessa (PDF, disegni, foto).
model Documento {
  id         String   @id @default(cuid())
  commessaId String?
  opportunitaId String?
  bozzaId    String?
  aggiornamentoId String?
  problemaId String?
  nomeFile   String
  categoria  String   @default("ALTRO") // vedi CATEGORIE_DOCUMENTO in enums.ts
  tipoMime   String?
  percorso   String // relativo alla cartella uploads: "<numeroCommessa>/<file>"
  dimensione Int?
  createdAt  DateTime @default(now())

  commessa Commessa? @relation(fields: [commessaId], references: [id], onDelete: Cascade)
  opportunita Opportunita? @relation(fields: [opportunitaId], references: [id], onDelete: Restrict)
  bozza BozzaCommessa? @relation(fields: [bozzaId], references: [id], onDelete: Restrict)
  aggiornamento AggiornamentoCantiere? @relation(fields: [aggiornamentoId], references: [id], onDelete: Restrict)
  problema ProblemaCantiere? @relation(fields: [problemaId], references: [id], onDelete: Restrict)

  @@index([commessaId])
  @@index([opportunitaId])
  @@index([bozzaId])
  @@index([aggiornamentoId])
  @@index([problemaId])
}

/// Nomi/ordine configurabili, significato stabile per conversione e indicatori.
model FaseCommerciale {
  id        String  @id @default(cuid())
  nome      String
  categoria String // APERTA | INVIATA | VINTA | PERSA
  ordine    Int
  attiva    Boolean @default(true)
  versione  Int     @default(1)
  opportunita Opportunita[]
}

model Opportunita {
  id                 String   @id @default(cuid())
  titolo             String
  anagraficaId       String
  referenteId        String?
  responsabileId     String?
  faseId             String
  tipologia          String   @default("P")
  origine            String?
  descrizione        String?
  valorePrevisto     Decimal? @db.Decimal(16, 2)
  riferimentoOfferta String?
  importoOfferta     Decimal? @db.Decimal(16, 2)
  dataInvioOfferta   DateTime? @db.Date
  motivazionePersa   String?
  chiusaIl          DateTime?
  ultimaInterazioneIl DateTime? @db.Date
  ultimaRispostaIl   DateTime? @db.Date
  faseAggiornataIl   DateTime @default(now())
  versione          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  anagrafica  Anagrafica @relation(fields: [anagraficaId], references: [id], onDelete: Restrict)
  referente   Referente? @relation(fields: [referenteId], references: [id], onDelete: Restrict)
  responsabile User? @relation(fields: [responsabileId], references: [id], onDelete: SetNull)
  fase        FaseCommerciale @relation(fields: [faseId], references: [id], onDelete: Restrict)
  commessa    Commessa?
  eventi      EventoCommerciale[]
  attivita    Attivita[]
  documenti   Documento[]

  @@index([faseId, createdAt])
  @@index([responsabileId])
  @@index([anagraficaId])
}

/// Timeline append-only: contatti effettivi e modifiche registrate separatamente.
model EventoCommerciale {
  id            String   @id @default(cuid())
  opportunitaId String?
  autoreId      String?
  autoreNome    String
  autoreRuolo   String
  tipo          String
  data          DateTime @db.Date
  testo         String
  esito         String?
  prima         Json?
  dopo          Json?
  richiestaId   String? @unique
  richiestaHash String?
  createdAt     DateTime @default(now())

  opportunita Opportunita? @relation(fields: [opportunitaId], references: [id], onDelete: Restrict)
  autore User? @relation(fields: [autoreId], references: [id], onDelete: SetNull)
  @@index([opportunitaId, data, createdAt])
}

/// Segnalazione di chi prova il CRM: problema riscontrato, miglioramento
/// proposto o domanda. Serve alla fase di test: chi prova annota cosa non torna,
/// allega uno screenshot, e chi sviluppa lavora sull'elenco e chiude.
model Segnalazione {
  id          String @id @default(cuid())
  titolo      String
  descrizione String

  tipo     String @default("PROBLEMA") // vedi TIPI_SEGNALAZIONE
  priorita String @default("MEDIA") // vedi PRIORITA_SEGNALAZIONE
  stato    String @default("APERTA") // vedi STATI_SEGNALAZIONE

  /// Percorso della schermata a cui si riferisce (es. "/commesse/abc"): con
  /// questo chi corregge sa dove guardare senza chiedere.
  pagina String?

  autoreId String

  /// Come è stata risolta. Compilata alla chiusura, resta come storico.
  risoluzione String?
  conclusaIl  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  autore   User                   @relation("SegnalazioneAutore", fields: [autoreId], references: [id])
  allegati AllegatoSegnalazione[]

  @@index([stato])
  @@index([autoreId])
  @@index([createdAt])
}

/// Immagine allegata a una segnalazione (di norma uno screenshot).
/// Come i documenti di commessa, i file stanno fuori da /public e passano da un
/// route handler autenticato.
model AllegatoSegnalazione {
  id             String @id @default(cuid())
  segnalazioneId String

  nomeFile   String
  tipoMime   String?
  percorso   String // relativo a UPLOADS_DIR: "segnalazioni/<id>/<file>"
  dimensione Int?

  createdAt DateTime @default(now())

  segnalazione Segnalazione @relation(fields: [segnalazioneId], references: [id], onDelete: Cascade)

  @@index([segnalazioneId])
}

/// Impostazioni globali chiave-valore (es. chiave API dell'assistente AI).
/// I valori sensibili sono cifrati a livello applicativo (src/lib/secrets.ts):
/// in `valore` non finisce mai un segreto in chiaro.
model Impostazione {
  id        String   @id @default(cuid())
  chiave    String   @unique
  valore    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cronologia privata. Il server è la fonte autorevole anche per i tool.
model AiConversation {
  id String @id @default(cuid())
  userId String
  title String
  context Json?
  accessKey String?
  busyUntil DateTime?
  lockToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]
  operations AiOperation[]
  @@index([userId, updatedAt])
}

model AiMessage {
  id String @id
  conversationId String
  payload Json
  createdAt DateTime @default(now())
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

/// Scrittura e ricevuta vengono salvate nella stessa transazione.
model AiOperation {
  id String @id @default(cuid())
  userId String
  conversationId String?
  requestKey String @unique
  accessKey String?
  command Json
  preview Json
  status String @default("PENDING")
  result Json?
  error String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model AiSchedule {
  id String @id @default(cuid())
  userId String
  name String
  enabled Boolean @default(true)
  hour Int @default(8)
  minute Int @default(0)
  weekdaysOnly Boolean @default(true)
  timezone String @default("Europe/Rome")
  followupDays Int @default(14)
  horizonDays Int @default(7)
  recipientIds Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs AiRun[]
}

model AiRun {
  id String @id @default(cuid())
  scheduleId String
  slot String
  status String @default("RUNNING")
  leaseUntil DateTime
  summary String?
  findings Json?
  usage Json?
  error String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  schedule AiSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  notifications Notifica[]
  @@unique([scheduleId, slot])
}

model Notifica {
  id String @id @default(cuid())
  userId String
  runId String?
  titolo String
  testo String
  href String
  eventoKey String? @unique
  letta Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  run AiRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([userId, runId])
  @@index([userId, letta, createdAt])
}

model Attivita {
  id String @id @default(cuid())
  titolo String
  note String?
  scadenza DateTime?
  stato String @default("DA_FARE")
  userId String
  commessaId String?
  clienteId String?
  opportunitaId String?
  problemaId String? @unique
  problema ProblemaCantiere? @relation(fields: [problemaId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  commessa Commessa? @relation(fields: [commessaId], references: [id], onDelete: SetNull)
  cliente Anagrafica? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  opportunita Opportunita? @relation(fields: [opportunitaId], references: [id], onDelete: Restrict)
  @@index([userId, stato, scadenza])
  @@index([opportunitaId, stato, scadenza])
}

/// Limite login condiviso tra processi; chiavi HMAC, nessuna email in chiaro.
model LoginRateLimit {
  key String @id
  attempts Int
  windowStartedAt DateTime
  @@index([windowStartedAt])
}
