// CRM Elettra S.r.l. — Schema dati
//
// Note di progetto:
// - Dev su SQLite (zero setup), produzione su PostgreSQL: lo schema è compatibile.
// - SQLite non supporta gli enum nativi di Prisma: i campi "a scelta chiusa"
//   (ruolo, stato, tipologia, titolo...) sono String, validati a livello
//   applicativo (src/lib/enums.ts + zod). Passando a Postgres si possono
//   convertire in enum nativi senza cambiare la logica.
// - Doppia natura Cliente/Fornitore: UNA anagrafica per azienda, con fino a due
//   codici (codiceCliente "C####" e codiceFornitore "F####").

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Utenti del CRM con ruolo (gerarchia di accesso).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nome         String
  cognome      String
  ruolo        String // vedi RUOLI in src/lib/enums.ts
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  commesse Commessa[] @relation("CommessaPM")

  @@index([ruolo])
}

/// Anagrafica azienda: può essere cliente e/o fornitore (doppia natura).
model Anagrafica {
  id              String  @id @default(cuid())
  ragioneSociale  String
  // Codifica doppia — al massimo uno per ruolo, univoci quando presenti.
  codiceCliente   String? @unique
  codiceFornitore String? @unique
  isCliente       Boolean @default(false)
  isFornitore     Boolean @default(false)

  // Dati fiscali e di contatto
  partitaIva     String?
  codiceFiscale  String?
  codiceSDI      String? // Codice destinatario / Univoco fatturazione
  indirizzo      String?
  cap            String?
  localita       String?
  provincia      String?
  telefono       String?
  fax            String?
  email          String?
  web            String?

  modalitaPagamento String?
  prodottiTrattati  String? // categorie merceologiche trattate (per i fornitori)
  note              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referenti       Referente[]
  commesse        Commessa[]        @relation("CommessaCliente")
  ordiniFornitore OrdineFornitore[] @relation("OrdineFornitore")

  @@index([ragioneSociale])
}

/// Referente normalizzato: titolo obbligatorio da lista (src/lib/enums.ts).
model Referente {
  id           String  @id @default(cuid())
  anagraficaId String
  titolo       String  @default("NESSUNO")
  nome         String
  cognome      String
  ruoloAzienda String? // es. "Responsabile acquisti"
  email        String?
  telefono     String?
  note         String?
  principale   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  anagrafica Anagrafica @relation(fields: [anagraficaId], references: [id], onDelete: Cascade)
  commesse   Commessa[]

  @@index([anagraficaId])
}

/// Commessa / Opportunità (pipeline commerciale).
model Commessa {
  id          String  @id @default(cuid())
  numero      String  @unique // formato AANNNN, es. "261041"
  anno        Int // es. 2026
  progressivo Int // 0..99999

  clienteId            String
  pmId                 String?
  referenteId          String?
  referenteCommerciale String? // sigla, es. "FG"

  stato      String  @default("LEAD") // vedi STATI_COMMESSA
  tipologia  String? // "P" (preventivo) | "C" (consuntivo)
  descrizione String?

  dataRichiesta         DateTime  @default(now())
  dataInvio             DateTime?
  importoOfferta        Decimal?
  importoOrdine         Decimal?
  dataOrdine            DateTime?
  metodoRicezioneOrdine String? // EMAIL | TELEFONO | CONTROFIRMA | NUMERO_ORDINE
  motivazionePersa      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente         Anagrafica        @relation("CommessaCliente", fields: [clienteId], references: [id])
  pm              User?             @relation("CommessaPM", fields: [pmId], references: [id])
  referente       Referente?        @relation(fields: [referenteId], references: [id])
  ordiniFornitore OrdineFornitore[]
  documenti       Documento[]

  @@index([clienteId])
  @@index([stato])
  @@index([anno])
}

/// Prodotto / materiale (con storico prezzi derivato dalle righe d'ordine).
model Prodotto {
  id          String  @id @default(cuid())
  codice      String? @unique
  descrizione String
  unitaMisura String?
  categoria   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  righeOrdine RigaOrdineFornitore[]

  @@index([descrizione])
}

/// Ordine a fornitore ("Elenco Analitico Ordini ai Fornitori").
/// Collegato alla commessa: è la chiave della regola bloccante P -> C.
model OrdineFornitore {
  id          String   @id @default(cuid())
  numero      String?
  data        DateTime @default(now())
  fornitoreId String
  commessaId  String?
  stato       String   @default("ORDINATO") // ORDINATO | ENTRATA | RICEVUTO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fornitore Anagrafica            @relation("OrdineFornitore", fields: [fornitoreId], references: [id])
  commessa  Commessa?             @relation(fields: [commessaId], references: [id])
  righe     RigaOrdineFornitore[]

  @@index([fornitoreId])
  @@index([commessaId])
}

/// Riga d'ordine: prodotto, quantità e prezzo. Alimenta lo storico prezzi.
model RigaOrdineFornitore {
  id            String   @id @default(cuid())
  ordineId      String
  prodottoId    String?
  codiceProdotto String?
  descrizione   String
  unitaMisura   String?
  quantita      Decimal  @default(0)
  prezzoUnitario Decimal @default(0)
  sconto        Decimal?
  imponibile    Decimal  @default(0)
  aliquotaIva   Decimal?

  // Entrata merce
  dataConsegnaPrevista DateTime?
  quantitaRicevuta     Decimal?
  ddtNumero            String?
  ddtData              DateTime?
  fatturaNumero        String?
  fatturaData          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordine   OrdineFornitore @relation(fields: [ordineId], references: [id], onDelete: Cascade)
  prodotto Prodotto?       @relation(fields: [prodottoId], references: [id])

  @@index([ordineId])
  @@index([prodottoId])
}

/// Documenti allegati alla commessa (PDF, disegni, foto).
model Documento {
  id         String   @id @default(cuid())
  commessaId String
  nomeFile   String
  categoria  String   @default("ALTRO") // vedi CATEGORIE_DOCUMENTO in enums.ts
  tipoMime   String?
  percorso   String // relativo alla cartella uploads: "<numeroCommessa>/<file>"
  dimensione Int?
  createdAt  DateTime @default(now())

  commessa Commessa @relation(fields: [commessaId], references: [id], onDelete: Cascade)

  @@index([commessaId])
}
