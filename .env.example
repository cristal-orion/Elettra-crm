# Sviluppo: docker compose up -d db; copiare questo file in .env.
DATABASE_URL="postgresql://elettra:elettra-local-only@127.0.0.1:55432/elettra?schema=public&connection_limit=10&connect_timeout=5&pool_timeout=5"

# Due segreti INDIPENDENTI: openssl rand -base64 32 per ciascuno.
SESSION_SECRET="cambiami-genera-con-openssl-rand-base64-32"
DATA_ENCRYPTION_SECRET="cambiami-genera-un-altro-segreto-casuale"

# Obbligatori in produzione: origine HTTPS senza slash finale, storage persistente.
# APP_ORIGIN="https://crm.example.it"
# UPLOADS_DIR="/data/uploads"

# Solo dati demo locali: seed esplicito, vietato con NODE_ENV=production.
SEED_PASSWORD=""

# Bootstrap su DB vuoto: npm run auth:bootstrap. Non conservarli dopo l'uso.
# ADMIN_EMAIL="admin@example.it"
# ADMIN_PASSWORD=""
# ADMIN_NOME="Admin"
# ADMIN_COGNOME="Elettra"

# Assistente AI opzionale. Nessun segreto deve avere prefisso NEXT_PUBLIC_.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash"

# Docker Compose produzione: DB non pubblicato, DATABASE_URL con host `db`.
# POSTGRES_PASSWORD=""
# POSTGRES_ADMIN_PASSWORD=""
# DATABASE_URL="postgresql://elettra:<password-url-encoded>@db:5432/elettra?schema=public&connection_limit=10&connect_timeout=5&pool_timeout=5"
# BACKUP_DIR="/srv/elettra-backups"
# BACKUP_DATABASE_URL="postgresql://elettra:<password-url-encoded>@db:5432/elettra"
# RESTIC_REPOSITORY="s3:https://endpoint.example.it/bucket/elettra"
# RESTIC_PASSWORD=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
