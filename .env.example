# Copia in .env e valorizza.

# Sviluppo: SQLite. Produzione: URL PostgreSQL (es. postgresql://user:pass@host:5432/db)
DATABASE_URL="file:./dev.db"

# Secret per firmare le sessioni JWT. Genera con: openssl rand -base64 32
SESSION_SECRET="cambiami-genera-con-openssl-rand-base64-32"

# Password degli utenti creati dal seed. OBBLIGATORIA: nel codice non esiste un
# default (sarebbe pubblico nel repository), quindi senza questa variabile
# "npm run db:seed" si interrompe e il container si rifiuta di partire.
# Genera con: openssl rand -base64 18
SEED_PASSWORD=""

# Cartella di archiviazione documenti (upload commesse). Opzionale:
# default = <cartella progetto>/uploads. In produzione usare un percorso su
# volume persistente (o sostituire lo storage con S3/oggetti).
# UPLOADS_DIR="/var/lib/elettra-crm/uploads"

# Assistente AI (Fase 8) — chiave API Google Gemini (lato server).
# Ottienila su https://aistudio.google.com/apikey . Senza questa chiave
# l'assistente resta disattivato (il resto del CRM funziona normalmente).
GEMINI_API_KEY=""
# Modello Gemini da usare. Default: gemini-3.5-flash (multimodale, per le visure).
# GEMINI_MODEL="gemini-3.5-flash"

# ---------------------------------------------------------------------------
# Solo deploy (Coolify / Docker) — vedi DEPLOY.md
# ---------------------------------------------------------------------------
# Carica i dati demo al primo avvio del container (default: true). Il seed
# svuota tutte le tabelle, quindi gira solo se il DB non esiste ancora.
# SEED_ON_FIRST_BOOT="true"
